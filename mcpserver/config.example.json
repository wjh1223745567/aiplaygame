{
  "window": {
    "title_keywords": ["问道"],
    "exclude_keywords": ["更新", "下载", "登录器", "launcher"]
  },
  "capture": {
    "debug_dir": "debug"
  },
  "input": {
    "click_random_offset": 4,
    "action_delay_min": 0.12,
    "action_delay_max": 0.3,
    "move_duration_sec": 0.18,
    "stop_hotkey": "f12"
  },
  "human_guard": {
    "enabled": true,
    "idle_resume_sec": 10,
    "program_grace_sec": 0.6,
    "max_pause_sec": 0,
    "max_block_sec": 30,
    "watch_clicks": true
  },
  "timing": {
    "step_pause": 0.4,
    "click_pause": 0.2,
    "idle_pause": 0.8
  },
  "ocr": {
    "engine": "rapidocr",
    "use_det": true,
    "min_confidence": 0.5
  },
  "template": {
    "templates_dir": "assets/templates",
    "default_threshold": 0.85,
    "multi_scale": true,
    "items": {
      "close_x":   {"file": "close_x.png",   "kind": "button"},
      "confirm":   {"file": "confirm.png",   "kind": "button"},
      "cancel":    {"file": "cancel.png",    "kind": "button"},
      "task_row":  {"file": "task_row.png",  "kind": "task"},
      "dialog_bg": {"file": "dialog_bg.png", "kind": "dialog"},
      "bag_icon":  {"file": "bag.png",       "kind": "icon"}
    }
  },
  "vision": {
    "clickable_kinds": ["button"],
    "empty_clickable_fallback": true
  },
  "yolo": {
    "enabled": true,
    "model_path": "assets/models/yolo-ui.pt",
    "conf_threshold": 0.25,
    "device": "cpu",
    "imgsz": 640,
    "ui_classes": ["button", "task", "info", "dialog", "icon"],
    "class_map": {
      "Sidebar": "info",
      "Visual_Elements": "icon",
      "Others": "info",
      "Unknown": "info"
    }
  },
  "general": {
    "enabled": true,
    "model_path": "assets/models/yolo11s.pt",
    "conf_threshold": 0.35,
    "device": "cpu",
    "imgsz": 1280,
    "classes": ["person"],
    "default_kind": "entity",
    "class_map": {}
  }
}
