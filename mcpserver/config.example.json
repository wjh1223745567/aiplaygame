{
  "window": {
    "title_keywords": ["问道"],
    "exclude_keywords": ["更新", "下载", "登录器", "launcher"]
  },
  "capture": {
    "debug_dir": "debug"
  },
  "input": {
    "click_random_offset": 4,
    "action_delay_min": 0.12,
    "action_delay_max": 0.3,
    "move_duration_sec": 0.18,
    "stop_hotkey": "f12"
  },
  "human_guard": {
    "enabled": true,
    "idle_resume_sec": 10,
    "program_grace_sec": 0.6,
    "max_pause_sec": 0,
    "max_block_sec": 30,
    "watch_clicks": true
  },
  "timing": {
    "step_pause": 0.4,
    "click_pause": 0.2,
    "idle_pause": 0.8
  },
  "ocr": {
    "engine": "rapidocr",
    "use_det": true,
    "min_confidence": 0.5
  },
  "template": {
    "templates_dir": "assets/templates",
    "default_threshold": 0.85,
    "multi_scale": true,
    "items": {
      "btn_friend":          {"file": "btn_friend.png",          "kind": "button"},
      "btn_bag":             {"file": "btn_bag.png",             "kind": "button"},
      "btn_expand":          {"file": "btn_expand.png",          "kind": "button"},
      "btn_realtime":        {"file": "btn_realtime.png",        "kind": "button"},
      "btn_shop_item":       {"file": "btn_shop_item.png",       "kind": "button"},
      "btn_shop_takeout":    {"file": "btn_shop_takeout.png",    "kind": "button"},
      "btn_battle_tutorial": {"file": "btn_battle_tutorial.png", "kind": "button"},
      "btn_party":           {"file": "btn_party.png",           "kind": "button"},
      "btn_task_accept":     {"file": "btn_task_accept.png",     "kind": "button"},
      "btn_shimen":          {"file": "btn_shimen.png",          "kind": "button"}
    }
  },
  "vision": {
    "clickable_kinds": ["button", "icon"],
    "clickable_sources": ["template", "yolo", "option"],
    "gate_by_top_layer": true,
    "option_by_color": true,
    "collect_failed_shots": true,
    "max_failed_shots": 300
  },
  "yolo": {
    "enabled": true,
    "model_path": "assets/models/yolo-ui.pt",
    "conf_threshold": 0.25,
    "device": "cpu",
    "imgsz": 640,
    "ui_classes": ["button", "task", "info", "dialog", "icon"],
    "class_map": {
      "Sidebar": "info",
      "Visual_Elements": "icon",
      "Others": "info",
      "Unknown": "info"
    }
  },
  "general": {
    "enabled": true,
    "model_path": "assets/models/yolo11s.pt",
    "conf_threshold": 0.35,
    "device": "cpu",
    "imgsz": 1280,
    "classes": ["person"],
    "default_kind": "entity",
    "class_map": {}
  }
}
