<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.autogame</groupId>
    <artifactId>autogame-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>mcpclient</artifactId>
  <name>mcpclient</name>
  <description>MCP client：以 stdio 拉起 Python server，并把工具封装成类型化方法</description>

  <dependencies>
    <!-- mcp 默认带 mcp-json-jackson3（Jackson 3），与 Spring Boot 3.3 管理的 Jackson 2 冲突
         （JsonProperty.isRequired 返回类型不同 -> NoSuchMethodError），因此换回 jackson2 实现。 -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
      <exclusions>
        <exclusion>
          <groupId>io.modelcontextprotocol.sdk</groupId>
          <artifactId>mcp-json-jackson3</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-json-jackson2</artifactId>
      <version>${mcp-sdk.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 对话调试台可执行包 target/chat.jar。
           用 outputFile 而不是替换主 artifact：host 仍依赖普通的 mcpclient jar。
           execution id 故意不叫 default、transformers/filters 加 combine.self="override"：
           Spring Boot 父 POM 的 pluginManagement 预设了一套 shade 配置，按位置合并会把
           它的 <resource> 塞进我们的 transformer 而导致配置解析失败。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <!-- 父 POM 的 pluginManagement 预设了一个 id=default 的 shade 执行（会把主 artifact
               替换成 uber jar，host 依赖它时体积暴增）。这里用 phase=none 把它禁掉。 -->
          <execution>
            <id>default</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>chat-jar</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/chat.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters combine.self="override">
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers combine.self="override">
                <!-- MCP SDK 靠 ServiceLoader 找 json 实现，必须合并 META-INF/services -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.autogame.client.ChatConsole</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
          <!-- Windows 图形客户端 target/client.jar（scripts/build-client-win.sh 打的便携包就用它）。
               与控制台各打一个 outputFile，互不影响。 -->
          <execution>
            <id>client-jar</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/client.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters combine.self="override">
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers combine.self="override">
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.autogame.client.ChatWindow</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
